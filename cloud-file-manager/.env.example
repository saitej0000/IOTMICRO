# Supabase Cloud Configuration
# Retrieve these credentials from your Supabase project dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon public key)

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Storage Bucket Name (must match the created private bucket in Supabase Storage)
SUPABASE_BUCKET=files

# App Execution Mode:
# 'cloud' = Uses real Supabase PostgreSQL & Supabase Storage
# 'local' = Uses in-memory / local SQLite & local storage (safe offline fallback)
APP_MODE=local

# Security & Session Settings
MAX_FILE_SIZE_MB=25
ENABLE_SHA256_FALLBACK=false
